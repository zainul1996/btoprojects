# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
*.tsbuildinfo
next-env.d.ts

# production
/build
/dist

# convex generated code
# convex/_generated is committed so Vercel builds work without Convex CLI auth

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets live here, never commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*

# vercel
.vercel

# scaffold temp
/.cna-temp/
/cna-temp/

# os / editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
